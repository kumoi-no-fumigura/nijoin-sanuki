 "poems": [
  {
   "seq": "1",
   "text": "靑柳のなひく下枝にはきてけり吹春風やともの宮つこ",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "我はさそしらせて過ば見えさらん霞にまかふ不破の關守",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "をのか咲雲ゐに君を待つけておもひせきもる花櫻哉",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "つねよりも山の葉しろき曙は夜の間に咲る櫻成けり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "暫しとも我はとゝめし春のうちはきとこん人を花にまかせて",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "花ならす月も見をきし雲の上に心はかりは出すとをしれ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "出しより空に知にき花の色も月も心に入ぬ君とは",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "庭たつみうつさゝりせは雲の上に又たくひある花と見ましや",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あかすして雲井の花にめかるれは心空なる春の夕暮",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "いつとても雲ゐの櫻なかりせは心そらなる〓とはあらしな",
   "kana": "",
   "speaker": "御製",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "散花の見えぬばかりそ惜みける心はひるにかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "春霞分行まゝに尾上なる松の綠そ色まさりける",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "咲初て我世にちらぬ花ならはあかぬ心のほとはみてまし",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "おもひきや雲井の花の咲さかす人傳にのみ聞む物とは",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "くる人もなき物ゆへによふこ鳥なれとならしの山に鳴らん",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "いつ方もちらさて行む岩つゝし左も右もまくりてにして",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春雨にしほれ〓〓て岩つゝし晴るけふこそ色まさりけれ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "身ひとつのなけきならねは暮て行春の別を問人そなき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "今はとて別るゝ春の夕霞こよひはかりや夏をへたてむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "いつくにか暮ぬる春はとまるらむ年は我身にそふとしりにき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "惜みつる春を限と思には殘れる花もみるそらそなき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "鳴捨て雲路過行ほとゝきす今一こゑは遠さかる也",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "諸共に旅ねする夜はほとゝきす梢やなれか庵成らむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "聲ならすしのたの杜の時鳥いつ里なれて宿にきなかん",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "里遠みまた咲やらぬ卯花やさらしもやらぬ布とみゆらん",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "長きねはあかぬ心を知へにてまたしらぬまの菖蒲をそひく",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "憑こし其かみ山の葵草おもへはかけぬ年のなきかな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "名殘なく晴ぬめれとそ早苗取田子の小笠はぬくよしもなし",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "思ひきや鹿にも逢ぬともしすと有明の月を待つへしとは",
   "kana": "",
   "speaker": "二條院讃岐集",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "さもこそは短き夜半の友ならめふすかともなく消る蚊遣火",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "さきた河くたす鵜舟にさす節の音寒るまて夜はふけにけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "橘の花吹かせをとめくれは珍らしけなきみきり也けり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "河竹のよ〓とにともす篝火はやとる螢のひかりなりけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "獨のみ岩井の水を結ひつゝそこなる影も君を待らし",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "照月の光を霜とをきなから盛にみゆる床なつの花",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "槇の戶をあけぬ音にやしるからん水鷄はそこを控けりとは",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "風そよくならの木陰に立よれはうすき衣そ先しられける",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "秋萩はこぼるゝ露のしけけれは折ふす枝をあくまてそ見る",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "吹ぬるは靡かぬにこそ花すゝき風に隨こゝろとはみれ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "軒ちかき荻の上葉の音せすは心とさむる夢にそ有まし",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "契あれや野邊の苅萱うつしうへて思ひみたるゝ友となしつる",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "志からめは花もちるらん小萩咲のへには鹿をすませすも哉",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "鐘をたにうち忘にし山寺に入あひは虫の聲のみそきく",
   "kana": "",
   "speaker": "二條院讃岐集",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "暮ぬとて待つる月の影〓みいつれはひるに又なりにけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "さたまらぬ雲の絕間の月かけは消て又ふる雲かとそみる",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "音はかり夜半の木のはにたくへとも時雨は庭に積らさりけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "時雨とてとゝめやはするみかりのゝ狩場の小野にあかぬ心は",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "明はてはさてたにもみむ木葉ちる庭をは霜のをきなかくしそ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "難波瀉みきはの芦は霜かれてなたの捨舟あらはれにけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "水鳥の上毛の霜は拂へとも下の氷やとくる間もなき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "我戀は志ほひに見えぬ奥の石の人こそふらねかはく間そなき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "明ぬれとまたきぬ〓〓になりやらて人の袖をもぬらしつる哉",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "今さらに戀していふも賴まれすこれも心のかはると思へは",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "一夜とてよかれし床の小筵にやかても塵のつもりぬる哉",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "今更にいかゝはすへき新枕年の三年は待わひぬとも",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "たのむれは涙の河もよとみけり人の情や井せき成らん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "めの前にかはる心をあら露の消はともにと何おもひ劔",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "逢と見る夢をさめつるくやしさに又まとろめと叶ばさりけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "夜とゝもに〓水に袖は濡せともこゆるよもなき相坂の關",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "今はさは何と命をかけよとて夢にも人の見えすなるらん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いたつらに歸そらより降雨は分て袖こそぬれまさりけれ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "夏の夜を何なけくらむひたすらに行て逢みぬ時もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "中絕しのなかの水の行末になかれあひてもぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "人ゑれす下に行かふ芦のねや君と我とか心なるらん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "かくてのみ絕て命のあらはこそかなはぬまても待心みめ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "待かねて絕す成なむ命をも我あらはこそ哀ともみめ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "女郞花亂るゝのへに入しよりかた志くよはゝ有しとそおもふ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "女郞花みたるゝのへはめもたゝて我故〓の花そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "我戀はをちのにすたく虫なれや啼とも人のふらはこそ有め",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "思ひかねけふいひそむる玉章に絕ぬ契を結ひつるかな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "そことたにふらせていにし我せこか留る笛の音にそなきめる",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "うしと思ふ人の心を種とする〓との葉をしもみるそかなしき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "いはてのみ憑そ渡よそなからみたらし河のをとに立ねと",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "我も又ふりなむ〓との近けれは長柄の橋をよそにやはきく",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "春日山生そふ松の枝とに木高くならん影をこそまて",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "遠さかるその古の戀しきに何行末のちかく成らむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "ぬらさるゝその袂にはあらねとも聞にくちなむ〓とそはかなき",
   "kana": "",
   "speaker": "御製",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "數ならぬ涙もいかにしられまし人の袂をぬらさゝりせは",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "思ひがねかへしつる哉から衣夢にもみゆるぬしや有とて",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "花の香の身にしむはかり匂ふかないかなる家の風にか有らむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "春の内に匂ひはかりの花の香をいかなる家の風とかはみる",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "今よりはたのみ渡らん八橋の下の心は我もしらねと",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "わたつ海の底ともなとかしらさらむみるめ絕ぬる心なりせは",
   "kana": "",
   "speaker": "二條院讃岐集",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "春の夜の夢には人の見えしかとまさしからても過にける哉",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "春のよの夢にしけにも見えたらはまさしからてはいかゝ有へき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "逢みても有ぬへしやと心みに立はなるれはぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "逢みてもあるへき事のあれはこそかねて心を心みるらん",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "思ふ〓としけみの庭の草の葉に涙の露はをきあまりけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "〓との葉の露はかりたにかけよかし草のゆかりの數ならすとも",
   "kana": "",
   "speaker": "大殿三川",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "紫の色に出てはいはねとも草のゆかりをわすれやはする",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "雨降は思ひこそやれいつみなるしのたの杜の下の陰くさ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "けふ聞は光もふるき月かけを出る初と思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "思ひきや花も我身もをくれゐてありし昔を忍ふへしとは",
   "kana": "",
   "speaker": "小侍從集",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "まきの戶をたゝく水雞に驚けはれぬ夜ぬるよそおなし數なる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "年〓とにまたぬうきのみ先たちてこゝろもとなき時鳥哉",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "ほとゝきす鳴つる空の五月雨にぬれぬる袖もなつかしきかな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
